{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                // "-fsanitize=address",

                "-g",
                "main.c",

                "./modules/*.c", 
                "./misc/*.c", 

                "-I .",
                "-I ./modules",
                "-I ./misc", 

                "-o",
                "${workspaceFolder}/.tmp/prog",

                "-lm", 

            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}