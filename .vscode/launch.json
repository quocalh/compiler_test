{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    {
        "name": "C/C++: gcc.exe build and debug active file",
        "type": "cppdbg",
        "request": "launch",
        // "program": "${fileDirname}\\${fileBasenameNoExtension}.exe""${fileDirname}/.tmp/prog",

        // "program": "${fileDirname}/.tmp/prog",
        "program": "${workspaceFolder}/.tmp/prog",
        "args": [],
        "stopAtEntry": false,

        // "cwd": "${fileDirname}",
        "cwd": "${workspaceFolder}",
        // https://stackoverflow.com/questions/54022889/leaksanitizer-not-working-under-gdb-in-ubuntu-18-04
        // choice: disable it when debugging, only detect leaks in runtime
        "environment": [
            {
                "name": "ASAN_OPTIONS",
                "value": "detect_leaks=0"
            }
        ],
        "externalConsole": false,
        "MIMode": "gdb",

        // "miDebuggerPath": "C:\\msys64\\mingw64\\bin\\gdb.exe""/usr/bin/gcc",

        "miDebuggerPath":"/usr/bin/gdb",

        // CRITICAL: RECOMPILES AND BUILDS THE LATEST CODE BEFORE LAUNCHING THE DEBUGGER SO YOU NEVER RUN OLD CODE ON F5
        // AUTOMATICALLY BUILDS AND UPDATES THE EXECUTABLE BEFORE RUNNING GDB TO PREVENT RUNNING OLD BUGGY BINARIES
        // WITHOUT IT, THE DEBUG FILE WILL RUN UPON THE PREVIOUS COMPILED FILE (OBSOLETE)
        "preLaunchTask": "C/C++: gcc build active file", // task.json build

        "setupCommands": [
        {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
        },
        ]
    }   

    ]
}